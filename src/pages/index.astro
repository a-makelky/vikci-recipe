---
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";

const publicStatuses = new Set(["approved", "needs_transcription"]);
const recipes = (await getCollection("recipes", ({ data }) => publicStatuses.has(data.review_status))).sort((left, right) =>
  left.data.title.localeCompare(right.data.title)
);
const transcribedCount = recipes.filter((entry) => entry.data.review_status === "approved").length;
const scanOnlyCount = recipes.filter((entry) => entry.data.review_status === "needs_transcription").length;
const balloonImage = "/images/vicki-hot-air-balloons.jpg";
---

<BaseLayout
  title="Welcome to Vicki's Website"
  description="Vicki Makelky's family recipe cards in a colorful searchable archive."
  bodyClass="home-page"
>
  <main class="home-main">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="theme-photo home-hero__photo">
        <img src={balloonImage} alt="Colorful hot air balloons floating together in the sky" loading="eager" />
      </div>

      <div class="home-hero__copy">
        <p class="eyebrow">Vicki Makelky's family archive</p>
        <h1 id="home-title">Welcome to Vicki's Website</h1>
        <p class="home-hero__lede">
          A bright, easy-to-read recipe archive with the original cards front and center.
        </p>
        <div class="home-hero__actions">
          <a class="button button--ghost" href="/recipes">Browse all recipes</a>
          <a class="button button--teal" href="/recipes#recipe-search">Search archive</a>
        </div>
        <div class="hero__stats" aria-label="Recipe archive status">
          <div>
            <strong>{recipes.length}</strong>
            <span>visible cards</span>
          </div>
          <div>
            <strong>{transcribedCount}</strong>
            <span>transcribed recipes</span>
          </div>
          <div>
            <strong>{scanOnlyCount}</strong>
            <span>scan-first entries</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
