---
import { getCollection } from "astro:content";

import RecipeExplorer from "@/components/RecipeExplorer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const publicStatuses = new Set(["approved", "needs_transcription"]);
const recipes = (await getCollection("recipes", ({ data }) => publicStatuses.has(data.review_status)))
  .sort((left, right) => left.data.title.localeCompare(right.data.title))
  .map((entry) => ({
    href: `/recipes/${entry.slug}`,
    recipe: entry.data
  }));
const transcribedCount = recipes.filter(({ recipe }) => recipe.review_status === "approved").length;
const scanOnlyCount = recipes.filter(({ recipe }) => recipe.review_status === "needs_transcription").length;
const balloonImage = "/images/vicky-vibe-hot-air-balloons.jpg";
---

<BaseLayout
  title="Recipes | Vicky Vibe Codes"
  description="Search and browse Vicki Makelky's colorful family recipe archive."
>
  <main>
    <a class="back-link" href="/">Vicky Vibe Codes</a>

    <section class="hero">
      <div class="theme-photo hero__photo">
        <img src={balloonImage} alt="Colorful hot air balloons photographed close together" loading="eager" />
      </div>

      <div class="hero__content">
        <p class="eyebrow">Recipe archive</p>
        <h1>Find the family recipe.</h1>
        <p class="hero__lede">
          Browse the original cards now. Searchable text is added as recipes clear review.
        </p>
        <div class="hero__actions hero__quick-links">
          <a class="button button--ghost" href="#recipe-search">Search</a>
          <a class="button button--primary" href="#recipe-grid">Browse cards</a>
          <a class="button button--teal" href="/">Home</a>
        </div>
        <div class="hero__stats">
          <div>
            <strong>{recipes.length}</strong>
            <span>visible cards</span>
          </div>
          <div>
            <strong>{transcribedCount}</strong>
            <span>transcribed recipes</span>
          </div>
          <div>
            <strong>{scanOnlyCount}</strong>
            <span>scan-first entries</span>
          </div>
        </div>
      </div>
    </section>

    <RecipeExplorer recipes={recipes} />
  </main>
</BaseLayout>
