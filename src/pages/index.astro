---
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";

const publicStatuses = new Set(["approved", "needs_transcription"]);
const recipes = (await getCollection("recipes", ({ data }) => publicStatuses.has(data.review_status))).sort((left, right) =>
  left.data.title.localeCompare(right.data.title)
);
const transcribedCount = recipes.filter((entry) => entry.data.review_status === "approved").length;
const scanOnlyCount = recipes.filter((entry) => entry.data.review_status === "needs_transcription").length;

const featuredSlugs = ["brazilian-limeade", "wendy-s-frosty", "toasted-almond-party-spread"];
const featuredRecipes = featuredSlugs
  .map((slug) => recipes.find((entry) => entry.slug === slug))
  .filter((entry) => entry !== undefined)
  .map((entry) => ({
    href: `/recipes/${entry.slug}`,
    title: entry.data.title,
    preview: entry.data.scan_assets.find((asset) => asset.role === "preview" && asset.type === "image")?.path
  }));
---

<BaseLayout
  title="Vicki Makelky"
  description="Vicki Makelky's family recipe cards, preserved as original scans and searchable recipes."
  bodyClass="home-page"
>
  <main class="home-main">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="eyebrow">Vicki Makelky</p>
        <h1 id="home-title">Family recipes, preserved from the original cards.</h1>
        <p class="home-hero__lede">
          Browse the cards as Vicki kept them. Clean transcriptions are added as each recipe clears review.
        </p>
        <div class="home-hero__actions">
          <a class="button button--primary" href="/recipes">Browse recipes</a>
        </div>
        <div class="hero__stats" aria-label="Recipe archive status">
          <div>
            <strong>{recipes.length}</strong>
            <span>visible cards</span>
          </div>
          <div>
            <strong>{transcribedCount}</strong>
            <span>transcribed recipes</span>
          </div>
          <div>
            <strong>{scanOnlyCount}</strong>
            <span>scan-first entries</span>
          </div>
        </div>
      </div>

      <div class="home-hero__scans" aria-label="Featured recipe cards">
        {
          featuredRecipes.map((recipe, index) => (
            <a class={`home-scan home-scan--${index + 1}`} href={recipe.href}>
              {recipe.preview ? (
                <img src={recipe.preview} alt={`Recipe card preview for ${recipe.title}`} loading={index === 0 ? "eager" : "lazy"} />
              ) : (
                <span>{recipe.title}</span>
              )}
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
